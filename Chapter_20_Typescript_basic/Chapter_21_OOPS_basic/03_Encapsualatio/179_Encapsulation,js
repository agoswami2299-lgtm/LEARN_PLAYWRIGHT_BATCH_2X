class BankAccount {
    #balance = 0; //private field -hidden from outside

    desposit(amount) {
        if (amount > 0); {
            this.#balance += amount;
        }
    }
    getBalance() {
        return this.#balance; //controlled access
    }
}

const account = new BankAccount();
account.desposit(100);
account.getBalance();

console.log(account.getBalance); //undefined (no public field by that name)